{
  "name": "dsh-connect-raccoon",
  "displayName": "DSH Connect 商汤小浣熊",
  "description": "把商汤小浣熊（SenseTime Raccoon，xiaohuanxiong.com）接入 DeepSeek Harness：有客户端时自动读取本机登录态，没有客户端时用网页授权/微信扫码登录记录账号；多账号账户池可勾选、可切换、可自动换号重试，模型目录、积分余额与每日签到都在设置页里。",
  "version": "0.0.1",
  "author": "xinstart-1",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sensetime",
    "raccoon",
    "xiaohuanxiong",
    "小浣熊",
    "account-pool",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-client.mjs && node scripts/check-client.mjs",
    "gate": "node scripts/gate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "check": "node scripts/gate.mjs",
    "probe:desktop": "node tools/probe-desktop-creds.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinstart-1/dsh-connect-raccoon.git"
  },
  "homepage": "https://github.com/xinstart-1/dsh-connect-raccoon#readme",
  "bugs": {
    "url": "https://github.com/xinstart-1/dsh-connect-raccoon/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.2.4-0 || >=0.2.4-rc.1 <0.2.5-0 || >=0.2.5-rc.1 <0.2.6-0 || >=0.2.6-rc.1 <0.2.7-0 || >=0.2.7-rc.1 <0.2.8-0 || >=0.2.8-rc.1 <0.2.9-0 || >=0.2.9-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0 || >=1.0.0-0 <2.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@earendil-works/pi-ai": "^1.0.0",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
